<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="AcademicPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Managed Entity Classes in com.university.core.model -->
        <class>com.university.core.model.BaseEntity</class>
        <class>com.university.core.model.NguoiDung</class>
        <class>com.university.core.model.SinhVien</class>
        <class>com.university.core.model.SinhVienUuTien</class>
        <class>com.university.core.model.NhanVien</class>
        <class>com.university.core.model.TroLyDaoTao</class>
        <class>com.university.core.model.TruongPhongDaoTao</class>
        <class>com.university.core.model.GiangVien</class>
        <class>com.university.core.model.HocKy</class>
        <class>com.university.core.model.HocPhan</class>
        <class>com.university.core.model.LopHocPhan</class>
        <class>com.university.core.model.HoSoHocPhan</class>
        <class>com.university.core.model.YeuCauMoLop</class>
        <class>com.university.core.model.LichHoc</class>
        <class>com.university.core.model.DiemDanh</class>
        <class>com.university.core.model.ThongBao</class>
        <class>com.university.core.model.enums.KetQuaConverter</class>

        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Dialect -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- SQL Formatting and Debugging -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>

            <!-- Schema Management -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>

            <!-- HikariCP Connection Pool (Optimized for Neon Serverless PostgreSQL) -->
            <property name="hibernate.connection.provider_class" value="org.hibernate.hikaricp.internal.HikariCPConnectionProvider"/>
            <property name="hibernate.hikari.minimumIdle" value="2"/>
            <property name="hibernate.hikari.maximumPoolSize" value="10"/>
            <property name="hibernate.hikari.idleTimeout" value="30000"/>
            <property name="hibernate.hikari.maxLifetime" value="600000"/>
            <property name="hibernate.hikari.connectionTimeout" value="20000"/>

            <!-- JDBC Batching -->
            <property name="hibernate.jdbc.batch_size" value="25"/>
            <property name="hibernate.order_inserts" value="true"/>
            <property name="hibernate.order_updates" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
